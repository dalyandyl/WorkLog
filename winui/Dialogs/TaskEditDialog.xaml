<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WorkLog_WinUI.Dialogs.TaskEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WorkLog_WinUI.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    PrimaryButtonClick="OnPrimaryClick"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Spacing="12" MinWidth="420" MaxWidth="480">
        <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" />

        <TextBox x:Name="TitleBox" Header="标题" PlaceholderText="任务标题" />

        <TextBox
            x:Name="BodyBox"
            Header="正文（Markdown）"
            AcceptsReturn="True"
            MinHeight="90"
            PlaceholderText="支持 Markdown"
            TextWrapping="Wrap" />

        <TextBox
            x:Name="NoteBox"
            Header="备注"
            AcceptsReturn="True"
            MinHeight="50"
            PlaceholderText="日报备注（所有天共享）"
            TextWrapping="Wrap" />

        <!-- 子任务 -->
        <StackPanel Spacing="6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="子任务" VerticalAlignment="Center" />
                <Button Grid.Column="1" Padding="6,3" Click="AddSubtask_Click" ToolTipService.ToolTip="添加子任务">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                </Button>
            </Grid>
            <ListView x:Name="SubtaskList" SelectionMode="None" MaxHeight="180">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SubtaskRow">
                        <Grid ColumnSpacing="8" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                MinWidth="0"
                                IsChecked="{x:Bind Done, Mode=TwoWay}" />
                            <TextBox
                                Grid.Column="1"
                                Padding="6,4"
                                Text="{x:Bind Title, Mode=TwoWay}" />
                            <Button
                                Grid.Column="2"
                                Padding="6,3"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="RemoveSubtask_Click"
                                Tag="{x:Bind}">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <InfoBar
            x:Name="SyncHint"
            IsOpen="True"
            Severity="Informational"
            Message="区间派发的任务：保存后同步更新到所有天" />
    </StackPanel>
</ContentDialog>
