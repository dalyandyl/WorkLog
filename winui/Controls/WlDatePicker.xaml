<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WorkLog_WinUI.Controls.WlDatePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WorkLog_WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 触发按钮 -->
    <Button x:Name="Trigger" Padding="10,6" Click="Trigger_Click">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8BF;" FontSize="14" />
            <TextBlock x:Name="Label" Text="选择日期" />
        </StackPanel>
    </Button>
</UserControl>
