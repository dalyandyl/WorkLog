<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WorkLog_WinUI.Controls.SidebarCalendar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ctl="using:WorkLog_WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8" Padding="12,8,12,4">
        <!-- 头部：‹ 年月（点击弹三级选择）› -->
        <Grid ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PrevBtn" Grid.Column="0" Click="PrevBtn_Click" ToolTipService.ToolTip="上个月"
                    Background="Transparent" BorderThickness="0" Padding="8,3">
                <TextBlock Text="‹" FontSize="15" />
            </Button>
            <ctl:WlDatePicker x:Name="TitlePick" Grid.Column="1" HorizontalAlignment="Center" />
            <Button x:Name="NextBtn" Grid.Column="2" Click="NextBtn_Click" ToolTipService.ToolTip="下个月"
                    Background="Transparent" BorderThickness="0" Padding="8,3">
                <TextBlock Text="›" FontSize="15" />
            </Button>
        </Grid>

        <!-- 星期表头（周一起始） -->
        <Grid x:Name="WeekHeader" />

        <!-- 日期网格 -->
        <Grid x:Name="DayGrid" />

        <!-- 底部操作 -->
        <StackPanel Spacing="6" Margin="0,4,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TodayBtn" Grid.Column="0" Click="TodayBtn_Click"
                        HorizontalAlignment="Stretch" FontSize="12" Padding="0,5">
                    回到今天
                </Button>
                <Button x:Name="RefreshBtn" Grid.Column="1" Click="RefreshBtn_Click"
                        HorizontalAlignment="Stretch" FontSize="12" Padding="0,5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="11" />
                        <TextBlock Text="更新日历" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock x:Name="StatusText" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
