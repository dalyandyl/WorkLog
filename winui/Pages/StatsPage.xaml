<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkLog_WinUI.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitle}" Text="统计" />

        <!-- 概览卡片：全部来自共享数据目录的真实数据 -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="记录天数" />
                    <TextBlock x:Name="DaysText" FontSize="32" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="任务总数" />
                    <TextBlock x:Name="TotalText" FontSize="32" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="完成数" />
                    <TextBlock x:Name="DoneText" FontSize="32" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="完成率" />
                    <TextBlock x:Name="RateText" FontSize="32" FontWeight="SemiBold" Text="—" />
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="EmptyHint"
                Grid.Row="1"
                Grid.ColumnSpan="4"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource PageSubtitle}"
                Text="数据目录暂无记录 —— 在 Electron 版创建任务后，这里会同步展示"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
