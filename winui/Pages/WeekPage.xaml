<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkLog_WinUI.Pages.WeekPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WorkLog_WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" Text="周报" />

        <ListView x:Name="WeekList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:WeekRow">
                    <Grid Padding="12,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind DayLabel}" />
                            <TextBlock Style="{StaticResource PageSubtitle}" FontSize="12" Text="{x:Bind Date}" />
                        </StackPanel>
                        <!-- 完成度条 -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Height="6" CornerRadius="3">
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="3" />
                            <Border
                                Width="{x:Bind BarWidth}"
                                HorizontalAlignment="Left"
                                CornerRadius="3"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource PageSubtitle}"
                            Text="{x:Bind Summary}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
