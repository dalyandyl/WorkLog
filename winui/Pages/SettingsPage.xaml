<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkLog_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="36,24" Spacing="24" MaxWidth="640">

            <TextBlock Style="{StaticResource PageTitle}" Text="设置" />

            <!-- 主题（WinUI 特色：跟随系统深浅色） -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="应用主题" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="跟随系统时自动响应 Windows 深浅色切换" />
                    <RadioButtons x:Name="ThemeGroup" SelectionChanged="ThemeGroup_SelectionChanged">
                        <RadioButton Content="跟随系统" Tag="system" />
                        <RadioButton Content="浅色" Tag="light" />
                        <RadioButton Content="深色" Tag="dark" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- 窗体材质（WinUI 特色：Mica / 亚克力） -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="窗口材质" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Mica 为 Windows 11 桌面云母材质；亚克力为磨砂半透明" />
                    <RadioButtons x:Name="BackdropGroup" SelectionChanged="BackdropGroup_SelectionChanged">
                        <RadioButton Content="Mica（推荐）" Tag="mica" />
                        <RadioButton Content="亚克力" Tag="acrylic" />
                        <RadioButton Content="纯色" Tag="none" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- 数据目录（与 Electron 版共享） -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="数据目录" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="与 Electron 版共用同一份数据，双方读写互通" />
                    <TextBlock x:Name="DataDirText" IsTextSelectionEnabled="True" FontFamily="Consolas" TextWrapping="Wrap" />
                    <Button x:Name="OpenDirBtn" Content="打开数据目录" Click="OpenDirBtn_Click" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="关于" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="WorkLog WinUI 0.1.0（骨架版）" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="基于 WinUI 3 / Windows App SDK 1.8 / .NET 10，Electron 版的并行原生实现" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
