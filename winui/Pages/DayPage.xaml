<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkLog_WinUI.Pages.DayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WorkLog_WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 日期选择 + 新建 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource PageTitle}"
                Text="日报" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="AddBtn" Style="{StaticResource AccentButtonStyle}" Click="AddBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="新建任务" />
                    </StackPanel>
                </Button>
                <Button x:Name="TodayBtn" Content="今天" Click="TodayBtn_Click" />
                <DatePicker x:Name="DatePick" DateChanged="DatePick_DateChanged" />
            </StackPanel>
        </Grid>

        <!-- 统计摘要 + 数据源提示 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
            <Border x:Name="DevBadge" CornerRadius="8" Padding="6,1" Visibility="Collapsed"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                <TextBlock FontSize="11" Text="dev 数据" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
        </StackPanel>

        <!-- 任务列表 -->
        <ListView x:Name="TaskList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DayRow">
                    <Grid Padding="12,10" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 勾选直接写回共享 JSON（区间任务多天同步） -->
                        <CheckBox
                            Grid.Column="0"
                            MinWidth="0"
                            Click="TaskCheck_Click"
                            IsChecked="{x:Bind Done, Mode=OneWay}"
                            Tag="{x:Bind Id}" />

                        <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <Border
                                Grid.Column="1"
                                CornerRadius="10"
                                Padding="8,2"
                                Visibility="{x:Bind SubtaskBadgeVis}"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{x:Bind SubtaskSummary}" />
                            </Border>
                            <!-- 标签色点 -->
                            <ItemsControl Grid.Column="2" ItemsSource="{x:Bind TagDots}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:TagDot">
                                        <Ellipse Width="8" Height="8">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{x:Bind Color}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- 行操作菜单 -->
                        <Button
                            Grid.Column="2"
                            Padding="4"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="{x:Bind Id}">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="编辑任务（所有天同步）" Click="EditItem_Click" Tag="{x:Bind Id}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="删除（进回收站）" Click="DeleteItem_Click" Tag="{x:Bind Id}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空状态 -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE8BF;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource PageSubtitle}"
                Text="这一天还没有任务" />
        </StackPanel>
    </Grid>
</Page>
