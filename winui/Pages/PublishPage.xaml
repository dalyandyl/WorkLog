<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkLog_WinUI.Pages.PublishPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <FontIcon Glyph="&#xE724;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <TextBlock Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Text="任务发布" />
        <TextBlock HorizontalAlignment="Center" Style="{StaticResource PageSubtitle}" Text="待实现：单日/区间派发任务（对齐 Electron 版 TaskPublish）" />
    </StackPanel>
</Page>
