<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkLog_WinUI.Pages.TrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <FontIcon Glyph="&#xE74D;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <TextBlock Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Text="回收站" />
        <TextBlock HorizontalAlignment="Center" Style="{StaticResource PageSubtitle}" Text="待实现：已删任务恢复（对齐 Electron 版 TrashView，数据在 trash.json）" />
    </StackPanel>
</Page>
